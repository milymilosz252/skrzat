<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.skrzat.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT__/server/skrzat-server.mjs</string>
  </array>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <true/>
  <key>StandardOutPath</key>  <string>__HOME__/Library/Logs/skrzat-server.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/skrzat-server.log</string>
  <key>ProcessType</key>      <string>Background</string>
</dict>
</plist>
